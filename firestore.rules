rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Painel administrativo: qualquer usuário autenticado (admin) pode ler/escrever.
    // Quando o cardápio público for criado, produtos deve virar leitura pública separada.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
