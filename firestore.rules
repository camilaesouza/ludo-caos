rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    // Vendedor = tem usuarios/{uid} com papel "vendedor". Quem não tem esse documento é admin
    // (primeiro usuário, criado no console, e quem foi cadastrado antes dos papéis).
    function ehVendedor() {
      let perfil = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(perfil) && get(perfil).data.papel == 'vendedor';
    }

    function ehAdmin() {
      return logado() && !ehVendedor();
    }

    // Admin lê e escreve tudo.
    match /{document=**} {
      allow read, write: if ehAdmin();
    }

    // Vendedor: área de pedidos completa.
    match /pedidos/{id} {
      allow read, write: if logado();
    }

    // Número automático dos pedidos.
    match /contadores/{id} {
      allow read, write: if logado();
    }

    // Vendedor vê os produtos e só altera o estoque (ao lançar, remover ou excluir itens de pedidos).
    match /produtos/{id} {
      allow read: if logado();
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estoque']);
    }

    // Taxas, para calcular o fechamento do pedido.
    match /configuracoes/{id} {
      allow read: if logado();
    }

    // Cada um lê o próprio cadastro, para o app saber o papel.
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
    }
  }
}
